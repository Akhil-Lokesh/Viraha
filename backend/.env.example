NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://viraha:viraha_dev_password@localhost:5433/viraha_dev

JWT_SECRET=change-this-to-a-random-secret-key
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key

CORS_ORIGIN=http://localhost:3000

# CSRF — required in production, optional in development (falls back to JWT_SECRET).
# Must be at least 32 chars and not a placeholder value when NODE_ENV=production.
CSRF_SECRET=change-this-to-a-csrf-specific-secret-min-32-chars

# Cloudflare R2 (optional — falls back to local disk)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=

# Redis (optional — caching disabled if not set)
REDIS_URL=redis://localhost:6379

# Sentry (optional)
# SENTRY_DSN=

# Google Places API (optional — location autocomplete)
# GOOGLE_PLACES_API_KEY=

# Resend (optional — email sending)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=noreply@viraha.app

# Google OAuth (optional — Sign-in-with-Google disabled if not set)
# The same client ID must be set as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend.
# GOOGLE_CLIENT_ID=

# Background jobs (optional — defaults: enabled in production, disabled elsewhere)
# ENABLE_JOBS=true
