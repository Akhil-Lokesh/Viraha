# Backend API (the Express server's /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public URL of this frontend (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google OAuth client ID (same as the backend's GOOGLE_CLIENT_ID).
# Leave empty to hide "Sign in with Google".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: public base URL of the Cloudflare R2 bucket when media is stored there.
NEXT_PUBLIC_R2_URL=
