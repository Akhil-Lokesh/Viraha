# =============================================================================
# Viraha — root .env for docker-compose.prod.yml
# =============================================================================
# Copy this file to `.env` and fill in real values before running
#   docker compose -f docker-compose.prod.yml up -d
#
# Every variable below is interpolated into the compose file. Variables marked
# REQUIRED are validated at backend boot (backend/src/config/env.ts) — the
# backend container exits immediately if a required value is missing or is left
# as a placeholder in production.
# =============================================================================

# --- Postgres (consumed by the postgres service) -----------------------------
# REQUIRED. Must match the credentials embedded in DATABASE_URL below.
POSTGRES_USER=viraha
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=viraha

# --- Backend core (REQUIRED) -------------------------------------------------
# Postgres connection string. Host is the compose service name `postgres`.
DATABASE_URL=postgresql://viraha:change-me-to-a-strong-db-password@postgres:5432/viraha

# Secrets MUST be at least 32 characters and MUST NOT contain placeholder words
# (e.g. "changeme", "secret", "placeholder") in production.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32-value
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32-value
CSRF_SECRET=replace-with-another-openssl-rand-hex-32-value

# Comma-free single origin allowed to call the API (your frontend URL).
CORS_ORIGIN=https://your-frontend-domain.example

# --- Redis (optional — caching disabled if unset) ----------------------------
# Host is the compose service name `redis`.
REDIS_URL=redis://redis:6379

# --- Cloudflare R2 object storage (optional — falls back to local disk) -------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the R2 bucket (e.g. https://pub-xxxx.r2.dev).
R2_PUBLIC_URL=

# --- Sentry error tracking (optional — disabled if unset) --------------------
SENTRY_DSN=

# --- Google Places autocomplete (optional — disabled if unset) ---------------
GOOGLE_PLACES_API_KEY=

# --- Resend transactional email (optional — disabled if unset) ---------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@viraha.app

# --- Google OAuth sign-in (optional — disabled if unset) ---------------------
GOOGLE_CLIENT_ID=

# --- Frontend build/runtime (consumed by the frontend service) ---------------
# Public URL of the backend API the browser will call.
NEXT_PUBLIC_API_URL=https://your-api-domain.example/api/v1
# Public base URL of the R2 bucket, used by next/image and the CSP allow-list.
NEXT_PUBLIC_R2_URL=
